{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs",
      "startServerReadyPattern": "Serving out/",
      "url": [
        "http://127.0.0.1:4311/en/",
        "http://127.0.0.1:4311/ar/",
        "http://127.0.0.1:4311/en/platform/",
        "http://127.0.0.1:4311/en/pricing/",
        "http://127.0.0.1:4311/en/product/pos/",
        "http://127.0.0.1:4311/en/industries/",
        "http://127.0.0.1:4311/en/industries/retail/",
        "http://127.0.0.1:4311/en/industries/manufacturing/",
        "http://127.0.0.1:4311/en/help/",
        "http://127.0.0.1:4311/en/help/assets/",
        "http://127.0.0.1:4311/en/solutions/multi-branch/",
        "http://127.0.0.1:4311/en/resources/glossary/",
        "http://127.0.0.1:4311/en/stories/journey-of-a-quote/",
        "http://127.0.0.1:4311/en/industries/farm/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/en/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          },
          "aggregationMethod": "median-run"
        },
        {
          "matchingUrlPattern": "/ar/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ]
          },
          "aggregationMethod": "median-run"
        },
        {
          "matchingUrlPattern": "/en/(platform|pricing|product/pos|industries|industries/retail|industries/manufacturing|help|help/assets|solutions/multi-branch|resources/glossary|stories/journey-of-a-quote|industries/farm)/$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
