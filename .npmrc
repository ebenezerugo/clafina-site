# Supply-chain settings (SECURITY_RULES.md 5.2-5.4, master copy in commerce-api/documentation; checked by scripts/check-security.sh).
# Install scripts never run on install. The packages that need a build step are rebuilt by name:
#   npm run rebuild:native   (esbuild and the other native packages; then the git hooks path)
ignore-scripts=true
# A version published less than 7 days ago is not installed (days; npm 11.10+). A security fix that cannot
# wait is installed with --min-release-age=0 and named in the pull request.
min-release-age=7
# No dependency from a git repository.
allow-git=none
