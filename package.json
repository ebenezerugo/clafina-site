{
  "name": "clafina-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "build:production": "CLAFINA_BUILD=production npm run check:production && CLAFINA_BUILD=production next build && npm run check:output",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:output": "tsx scripts/check-output.ts",
    "serve:out": "node scripts/serve-out.mjs",
    "check:production": "tsx --tsconfig tsconfig.json scripts/check-production.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
