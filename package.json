{
  "name": "clafina-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "build:production": "CLAFINA_BUILD=production npm run check:production && CLAFINA_BUILD=production npm run build && CLAFINA_BUILD=production npm run check:content && npm run check:output && npm run check:links",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:output": "tsx scripts/check-output.ts",
    "serve:out": "node scripts/serve-out.mjs",
    "check:production": "tsx --tsconfig tsconfig.json scripts/check-production.ts",
    "check:css": "tsx scripts/check-logical-css.ts",
    "check:content": "tsx scripts/check-content.ts",
    "prebuild": "tsx scripts/generate-well-known.ts && tsx scripts/script-fonts.ts && tsx scripts/draw-illustrations.mjs",
    "postbuild": "tsx scripts/postbuild.ts",
    "check:links": "tsx scripts/check-links.ts",
    "sync:help": "tsx scripts/sync-help.ts",
    "draw": "tsx scripts/draw-illustrations.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-ethiopic": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
