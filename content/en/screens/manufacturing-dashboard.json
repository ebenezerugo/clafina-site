    { "type": "stats", "items": [
      { "icon": "clock", "label": "Availability", "value": "91%", "change": { "tone": "good", "text": "2 pts better", "dir": "up" }, "note": "Run time ÷ (run time + unplanned stops)" },
      { "icon": "chart", "label": "Performance", "value": "92%", "change": { "tone": "good", "text": "1 pt better", "dir": "up" }, "note": "Standard minutes of units made ÷ run time" },
      { "icon": "check", "label": "Good-unit rate", "value": "98%", "change": { "tone": "good", "text": "0.4 pts better", "dir": "up" }, "note": "Good units ÷ (good + scrap)" },
      { "icon": "up", "label": "OEE", "value": "82%", "change": { "tone": "good", "text": "3 pts better", "dir": "up" }, "note": "91% × 92% × 98%" }
    ] },
    { "type": "stats", "items": [
      { "icon": "box", "label": "Throughput", "value": "18,420 good units", "change": { "tone": "good", "text": "8% more", "dir": "up" } },
      { "icon": "down", "label": "Scrap rate", "value": "2.0%", "change": { "tone": "good", "text": "0.4 points lower", "dir": "down" }, "note": "380 scrapped ÷ 18,800 made" },
