      { "icon": "table", "label": "Machines out of use", "value": "2", "note": "1 broken down, 1 in maintenance" }
    ] },
    { "type": "row", "widths": "3fr 2fr", "blocks": [
      { "type": "attention", "title": "Where production is stuck right now", "items": [
        { "tone": "bad", "icon": "alert", "title": "Filler FL-01 broke down at 07:40", "body": "Groundnut oil 1L on filling line 1 is stopped. WO-2026-0148 waits on it, and PRO-2026-0061 may finish a day after 23 Oct.", "action": "Open the machine" },
        { "tone": "warn", "icon": "box", "title": "3 production orders are short of materials", "body": "Tomato paste needs 3,000 tin cans; none are held and none are on order.", "action": "See what is short" },
        { "tone": "warn", "icon": "clock", "title": "PRO-2026-0058 Pepper mix 200g is 3 days late", "body": "It was due 16 Oct. It is now expected to finish on 20 Oct.", "action": "Open the order" }
      ] },
      { "type": "table", "title": "Where the time was lost: 25.5 h stopped, 18.5 h unplanned", "columns": [{ "label": "Reason" }, { "label": "Hours", "numeric": true }, { "label": "Kind" }], "rows": [
