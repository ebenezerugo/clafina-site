        ["Changeovers between products", "7 h", { "pill": "neutral", "text": "Planned" }],
        ["Waiting for material", "5 h", { "pill": "bad", "text": "Unplanned" }],
        ["No operator", "2.5 h", { "pill": "bad", "text": "Unplanned" }]
      ] }
    ] },
    { "type": "kv", "title": "On the floor", "items": [
      { "label": "Orders in hand", "value": "12, not yet completed" },
      { "label": "Work orders under way", "value": "7" },
